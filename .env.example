# Kopieren nach .env (nicht einchecken). Die App liest .env von selbst, gesucht wird im aktuellen
# Ordner und darüber. Echte Umgebungsvariablen gehen vor. Aus backend/ starten mit:
# uv run uvicorn coop_manager.app:app --reload
# Ordner für eventstore.sqlite und projections.sqlite
CM_DATA_DIR=data
# DEBUG, INFO, WARNING, ERROR oder CRITICAL
CM_LOG_LEVEL=INFO
# IP-Adressen von Reverse Proxys, deren X-Forwarded-*-Headern die App glaubt, mit Komma getrennt.
# Leer lassen, wenn kein Proxy davor steht.
CM_TRUSTED_PROXIES=
# Login-Sperre: nach so vielen Fehlversuchen ist der Benutzername so viele Sekunden gesperrt
CM_LOGIN_MAX_ATTEMPTS=3
CM_LOGIN_LOCKOUT_SECONDS=900
# Schlüssel zum Signieren des Session-Cookies; erzeugen mit: python3 -c "import secrets; print(secrets.token_hex(32))"
# Leer: zufälliger Schlüssel bei jedem Start, alle Sessions enden dann mit einem Neustart.
CM_SECRET_KEY=
# Session endet nach so vielen Sekunden ohne Anfrage
CM_SESSION_TIMEOUT=1800
# Cookie nur über HTTPS senden; Browser erlauben das auch für http://localhost
CM_SESSION_COOKIE_SECURE=true
# Bezeichnung des Genossenschaftskontos (Nummer 9999), gilt beim Anlegen mit
# uv run coop-manager create-cooperative-account
CM_COOPERATIVE_ACCOUNT_NAME=Unser Dorfladen Schlichten eG
# Ordner mit der gebauten Vue-App (npm run build erzeugt frontend/dist). Leer: Die App liefert keine
# Oberfläche aus, in der Entwicklung macht das Vite. Lokal ausprobieren mit ../frontend/dist
CM_FRONTEND_DIR=
# API-Dokumentation unter /docs, /redoc und /openapi.json; im Betrieb aus, lokal true
CM_API_DOCS=false
